# Environment configuration for Talanta Stadium
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# PostgreSQL connection. Prefer a managed database secret in production.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/talanta_stadium
DATABASE_SSL=false
SQL_POOL_MAX=10

# Firebase browser config
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=talanta-stadium-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=talanta-stadium-dev
VITE_FIREBASE_STORAGE_BUCKET=talanta-stadium-dev.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo-app-id

# Server-side Firebase/Admin project identifier
GOOGLE_CLOUD_PROJECT=talanta-stadium-dev
FIREBASE_PROJECT_ID=talanta-stadium-dev

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key

# Optional AI services
GEMINI_API_KEY=your-gemini-key

# M-Pesa placeholders. Payment work is intentionally deferred.
DARAJA_CONSUMER_KEY=your_daraja_consumer_key
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret
DARAJA_PASSKEY=your_daraja_passkey
DARAJA_BUSINESS_SHORTCODE=174379
DARAJA_ENV=sandbox
DARAJA_CALLBACK_URL=http://localhost:3000/api/payments/mpesa/callback
