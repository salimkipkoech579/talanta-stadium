# Runtime
NODE_ENV=production
PORT=8080
APP_URL=https://your-domain.example

# PostgreSQL / Cloud SQL
# Prefer a managed secret for this value; do not commit a real connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
SQL_POOL_MAX=10

# Firebase Admin uses Application Default Credentials on Google Cloud.
GOOGLE_CLOUD_PROJECT=your-firebase-project-id

# Firebase browser configuration (public identifiers; restrict API key by domain in Google Cloud).
VITE_FIREBASE_API_KEY=your-public-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id

# Google Maps browser key (optional; restrict by allowed website origins).
VITE_GOOGLE_MAPS_API_KEY=your-restricted-maps-key

# Optional AI Studio integration.
GEMINI_API_KEY=your-gemini-api-key
