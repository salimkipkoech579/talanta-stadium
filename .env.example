# Public browser configuration (publishable key only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-side token validation. The publishable/anon key is not a service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Server-side privileged key. Keep only in a secret manager; never expose to Vite or commit it.
SUPABASE_SERVICE_ROLE_KEY=replace-through-secret-manager

# Existing Drizzle/Postgres connection. Obtain the actual connection string from Supabase dashboard.
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@db.your-project.supabase.co:5432/postgres
DATABASE_SSL=true
SQL_POOL_MAX=10

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
VITE_GOOGLE_MAPS_API_KEY=your-restricted-maps-key
GEMINI_API_KEY=your-gemini-api-key

# Payment configuration intentionally deferred; do not enable simulated payment in production.
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_PASSKEY=
DARAJA_BUSINESS_SHORTCODE=
DARAJA_ENV=sandbox
DARAJA_CALLBACK_URL=
